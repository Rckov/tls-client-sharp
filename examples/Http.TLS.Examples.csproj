<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<Platforms>x64;AnyCPU</Platforms>
		<LangVersion>Latest</LangVersion>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<PreBuildEvent>
			echo [bogdanfinn/tls-client] Checking update...
			powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildThisFileDirectory)..\build\update-tls-client.ps1"
			if %ERRORLEVEL% neq 0 exit /b %ERRORLEVEL%
			powershell -NoProfile -Command "Write-Host '[bogdanfinn/tls-client] Checking update complete. Updated to ' -NoNewline; Write-Host (Get-Content '$(MSBuildThisFileDirectory)..\build\tls-client-version.txt')"
		</PreBuildEvent>
	</PropertyGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\src\Http.TLS.csproj" />
		
		<Content Include="$(MSBuildThisFileDirectory)..\build\tls-client.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>tls-client.dll</Link>
			<Visible>false</Visible>
		</Content>
	</ItemGroup>
</Project>